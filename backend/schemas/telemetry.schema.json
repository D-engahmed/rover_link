{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoverTelemetry",
  "type": "object",
  "required": ["rover_id", "timestamp_ms", "mode", "front_distance_cm"],
  "properties": {
    "rover_id": {"type": "string"},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "mode": {"enum": ["manual", "autonomous", "emergency_stop"]},
    "front_distance_cm": {"type": "integer", "minimum": 0},
    "left_distance_cm": {"type": "integer", "minimum": 0},
    "right_distance_cm": {"type": "integer", "minimum": 0},
    "battery_percent": {"type": "integer", "minimum": 0, "maximum": 100},
    "target_type": {"type": ["string", "null"]},
    "target_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "target_distance_cm": {"type": ["integer", "null"], "minimum": 0},
    "target_angle_deg": {"type": ["number", "null"]}
  }
}
